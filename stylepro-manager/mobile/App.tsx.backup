
import React, { useEffect, useState } from 'react'
import {
  ActivityIndicator,
  Alert,
  SafeAreaView,
  ScrollView,
  StatusBar,
  StyleSheet,
  Text,
  TextInput,
  TouchableOpacity,
  View,
} from 'react-native'
import { LogIn, LogOut, Package, Store as StoreIcon } from 'lucide-react-native'
import type { User } from '@supabase/supabase-js'
import { supabase } from './src/lib/supabase'

type StoreRow = {
  id: string
  name: string
  currency: string
}

type ProductRow = {
  id: string
  name: string
  target_audience: string | null
  description: string | null
  active: boolean
  image_url: string | null
}

const COLORS = {
  background: '#F1EBDD',
  surface: '#FFFCF6',
  navy: '#202C3C',
  text: '#263243',
  muted: '#7B817F',
  border: '#DED6C6',
  accent: '#B58A52',
  danger: '#B94242',
}

export default function App() {
  const [user, setUser] = useState<User | null>(null)
  const [ready, setReady] = useState(false)
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [stores, setStores] = useState<StoreRow[]>([])
  const [storeId, setStoreId] = useState('')
  const [products, setProducts] = useState<ProductRow[]>([])
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState('')

  useEffect(() => {
    let alive = true

    supabase.auth.getSession().then(({ data, error }) => {
      if (!alive) return
      if (error) setError(error.message)
      setUser(data.session?.user ?? null)
      setReady(true)
    })

    const { data: listener } = supabase.auth.onAuthStateChange(
      (_event, session) => {
        setUser(session?.user ?? null)
      },
    )

    return () => {
      alive = false
      listener.subscription.unsubscribe()
    }
  }, [])

  useEffect(() => {
    if (!user) {
      setStores([])
      setStoreId('')
      setProducts([])
      return
    }

    let alive = true

    async function loadStores() {
      setLoading(true)
      setError('')

      const { data, error } = await supabase
        .from('stores')
        .select('id,name,currency')
        .order('created_at', { ascending: true })

      if (!alive) return

      if (error) {
        setError(error.message)
        setStores([])
      } else {
        const rows = (data ?? []) as StoreRow[]
        setStores(rows)
        setStoreId(current =>
          rows.some(row => row.id === current)
            ? current
            : rows[0]?.id ?? '',
        )
      }

      setLoading(false)
    }

    void loadStores()

    return () => {
      alive = false
    }
  }, [user])

  useEffect(() => {
    if (!storeId) {
      setProducts([])
      return
    }

    let alive = true

    async function loadProducts() {
      setLoading(true)
      setError('')

      const { data, error } = await supabase
        .from('products')
        .select(
          'id,name,target_audience,description,active,image_url',
        )
        .eq('store_id', storeId)
        .order('name')

      if (!alive) return

      if (error) {
        setError(error.message)
        setProducts([])
      } else {
        setProducts((data ?? []) as ProductRow[])
      }

      setLoading(false)
    }

    void loadProducts()

    return () => {
      alive = false
    }
  }, [storeId])

  async function signIn() {
    if (!email.trim() || !password) {
      setError('Saisis ton e-mail et ton mot de passe.')
      return
    }

    setLoading(true)
    setError('')

    const { error } = await supabase.auth.signInWithPassword({
      email: email.trim(),
      password,
    })

    if (error) setError(error.message)
    setLoading(false)
  }

  async function signOut() {
    const { error } = await supabase.auth.signOut()
    if (error) Alert.alert('Erreur', error.message)
  }

  if (!ready) {
    return (
      <SafeAreaView style={styles.center}>
        <ActivityIndicator size="large" color={COLORS.accent} />
        <Text style={styles.muted}>Chargement de StylePro...</Text>
      </SafeAreaView>
    )
  }

  if (!user) {
    return (
      <SafeAreaView style={styles.screen}>
        <StatusBar barStyle="dark-content" />
        <View style={styles.loginContainer}>
          <View style={styles.logo}>
            <StoreIcon color={COLORS.surface} size={30} />
          </View>
          <Text style={styles.brand}>STYLEPRO</Text>
          <Text style={styles.heading}>Gestion de votre boutique</Text>
          <Text style={styles.subtitle}>
            Stock, produits et ventes au même endroit.
          </Text>

          <View style={styles.card}>
            <Text style={styles.label}>Adresse e-mail</Text>
            <TextInput
              value={email}
              onChangeText={setEmail}
              placeholder="nom@exemple.com"
              placeholderTextColor={COLORS.muted}
              keyboardType="email-address"
              autoCapitalize="none"
              autoCorrect={false}
              style={styles.input}
            />

            <Text style={styles.label}>Mot de passe</Text>
            <TextInput
              value={password}
              onChangeText={setPassword}
              placeholder="Votre mot de passe"
              placeholderTextColor={COLORS.muted}
              secureTextEntry
              style={styles.input}
            />

            {error ? <Text style={styles.error}>{error}</Text> : null}

            <TouchableOpacity
              style={styles.primaryButton}
              onPress={signIn}
              disabled={loading}
            >
              {loading ? (
                <ActivityIndicator color="#FFFFFF" />
              ) : (
                <>
                  <LogIn color="#FFFFFF" size={19} />
                  <Text style={styles.primaryButtonText}>
                    Se connecter
                  </Text>
                </>
              )}
            </TouchableOpacity>
          </View>

          <Text style={styles.footer}>
            StylePro Manager · Gestion commerciale
          </Text>
        </View>
      </SafeAreaView>
    )
  }

  return (
    <SafeAreaView style={styles.screen}>
      <StatusBar barStyle="dark-content" />
      <ScrollView contentContainerStyle={styles.content}>
        <View style={styles.header}>
          <View>
            <Text style={styles.brand}>STYLEPRO</Text>
            <Text style={styles.subtitle}>Espace de gestion</Text>
          </View>
          <TouchableOpacity onPress={signOut} style={styles.iconButton}>
            <LogOut size={20} color={COLORS.navy} />
          </TouchableOpacity>
        </View>

        <View style={styles.welcome}>
          <Text style={styles.welcomeTitle}>Bonjour 👋</Text>
          <Text style={styles.subtitle}>
            {user.email ?? 'Utilisateur connecté'}
          </Text>
        </View>

        <Text style={styles.sectionTitle}>Mes boutiques</Text>

        {stores.length === 0 && !loading ? (
          <View style={styles.card}>
            <Text style={styles.body}>
              Aucune boutique accessible avec ce compte.
            </Text>
          </View>
        ) : (
          stores.map(store => (
            <TouchableOpacity
              key={store.id}
              style={[
                styles.storeCard,
                store.id === storeId && styles.selectedStore,
              ]}
              onPress={() => setStoreId(store.id)}
            >
              <View style={styles.storeIcon}>
                <StoreIcon size={22} color={COLORS.accent} />
              </View>
              <View style={styles.flex}>
                <Text style={styles.storeName}>{store.name}</Text>
                <Text style={styles.subtitle}>{store.currency}</Text>
              </View>
              <Text style={styles.storeAction}>
                {store.id === storeId ? 'Sélectionnée' : 'Ouvrir'}
              </Text>
            </TouchableOpacity>
          ))
        )}

        <View style={styles.sectionRow}>
          <Text style={styles.sectionTitle}>Catalogue</Text>
          <Package size={21} color={COLORS.accent} />
        </View>

        <View style={styles.statsCard}>
          <Text style={styles.statsNumber}>{products.length}</Text>
          <Text style={styles.subtitle}>Produits chargés depuis Supabase</Text>
        </View>

        {loading ? (
          <ActivityIndicator
            style={styles.loader}
            size="large"
            color={COLORS.accent}
          />
        ) : products.map(product => (
          <View key={product.id} style={styles.productCard}>
            <View style={styles.productIcon}>
              <Package size={21} color={COLORS.navy} />
            </View>
            <View style={styles.flex}>
              <Text style={styles.productName}>{product.name}</Text>
              <Text style={styles.subtitle}>
                {product.target_audience || 'Catégorie non renseignée'}
              </Text>
              <Text style={product.active ? styles.active : styles.inactive}>
                {product.active ? 'Actif' : 'Inactif'}
              </Text>
            </View>
          </View>
        ))}

        {error ? <Text style={styles.error}>{error}</Text> : null}
      </ScrollView>
    </SafeAreaView>
  )
}

const styles = StyleSheet.create({
  screen: { flex: 1, backgroundColor: COLORS.background },
  center: {
    flex: 1,
    backgroundColor: COLORS.background,
    alignItems: 'center',
    justifyContent: 'center',
    gap: 12,
  },
  loginContainer: { flex: 1, justifyContent: 'center', padding: 24 },
  logo: {
    width: 64,
    height: 64,
    borderRadius: 20,
    backgroundColor: COLORS.navy,
    alignItems: 'center',
    justifyContent: 'center',
    marginBottom: 18,
  },
  brand: {
    color: COLORS.navy,
    fontSize: 13,
    fontWeight: '900',
    letterSpacing: 3,
  },
  heading: {
    color: COLORS.text,
    fontSize: 28,
    lineHeight: 35,
    fontWeight: '800',
    marginTop: 12,
  },
  subtitle: { color: COLORS.muted, fontSize: 13, marginTop: 4 },
  card: {
    backgroundColor: COLORS.surface,
    borderRadius: 22,
    padding: 20,
    marginTop: 26,
    borderWidth: 1,
    borderColor: COLORS.border,
  },
  label: {
    color: COLORS.text,
    fontSize: 13,
    fontWeight: '700',
    marginBottom: 8,
    marginTop: 8,
  },
  input: {
    backgroundColor: '#F7F3EA',
    borderWidth: 1,
    borderColor: COLORS.border,
    borderRadius: 12,
    paddingHorizontal: 14,
    paddingVertical: 13,
    fontSize: 15,
    color: COLORS.text,
    marginBottom: 10,
  },
  primaryButton: {
    backgroundColor: COLORS.navy,
    borderRadius: 13,
    padding: 15,
    marginTop: 12,
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
    gap: 10,
  },
  primaryButtonText: { color: '#FFFFFF', fontWeight: '800', fontSize: 15 },
  error: { color: COLORS.danger, marginTop: 12, fontSize: 13 },
  footer: {
    textAlign: 'center',
    color: COLORS.muted,
    fontSize: 12,
    marginTop: 24,
  },
  content: { padding: 20, paddingBottom: 40 },
  header: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
  },
  iconButton: {
    backgroundColor: COLORS.surface,
    borderRadius: 13,
    padding: 12,
    borderWidth: 1,
    borderColor: COLORS.border,
  },
  welcome: {
    backgroundColor: COLORS.navy,
    padding: 22,
    borderRadius: 20,
    marginTop: 24,
    marginBottom: 26,
  },
  welcomeTitle: { color: '#FFFFFF', fontSize: 25, fontWeight: '800' },
  sectionTitle: {
    color: COLORS.text,
    fontSize: 18,
    fontWeight: '800',
    marginBottom: 12,
  },
  storeCard: {
    flexDirection: 'row',
    alignItems: 'center',
    backgroundColor: COLORS.surface,
    padding: 15,
    borderRadius: 16,
    borderWidth: 1,
    borderColor: COLORS.border,
    marginBottom: 10,
    gap: 12,
  },
  selectedStore: { borderColor: COLORS.accent, borderWidth: 2 },
  storeIcon: {
    width: 44,
    height: 44,
    backgroundColor: '#F1E7D4',
    borderRadius: 13,
    alignItems: 'center',
    justifyContent: 'center',
  },
  flex: { flex: 1 },
  storeName: { color: COLORS.text, fontWeight: '800', fontSize: 15 },
  storeAction: { color: COLORS.accent, fontSize: 12, fontWeight: '800' },
  sectionRow: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
    marginTop: 20,
  },
  statsCard: {
    backgroundColor: COLORS.surface,
    padding: 20,
    borderRadius: 18,
    borderWidth: 1,
    borderColor: COLORS.border,
    marginBottom: 12,
  },
  statsNumber: { color: COLORS.navy, fontSize: 32, fontWeight: '900' },
  body: { color: COLORS.text, fontSize: 14 },
  productCard: {
    flexDirection: 'row',
    gap: 12,
    alignItems: 'center',
    padding: 15,
    backgroundColor: COLORS.surface,
    borderRadius: 15,
    borderWidth: 1,
    borderColor: COLORS.border,
    marginBottom: 10,
  },
  productIcon: {
    backgroundColor: '#F1E7D4',
    width: 44,
    height: 44,
    borderRadius: 12,
    alignItems: 'center',
    justifyContent: 'center',
  },
  productName: { color: COLORS.text, fontSize: 14, fontWeight: '800' },
  active: { color: '#28734D', fontSize: 12, marginTop: 5 },
  inactive: { color: COLORS.danger, fontSize: 12, marginTop: 5 },
  muted: { color: COLORS.muted },
  loader: { margin: 24 },
})
