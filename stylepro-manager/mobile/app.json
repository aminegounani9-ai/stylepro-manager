{
  "expo": {
    "name": "StylePro Manager",
    "slug": "stylepro-manager",
    "scheme": "stylepro",
    "version": "1.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.stylepro.manager",
      "supportsTablet": true,
      "buildNumber": "3"
    },
    "android": {
      "package": "com.stylepro.manager",
      "versionCode": 3,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "CAMERA"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "navigationBarColor": "#F4EFE5",
      "backgroundColor": "#F4EFE5",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#243b35"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "StylePro Manager utilise la caméra pour scanner les codes-barres et QR des articles.",
          "barcodeScannerEnabled": true
        }
      ],
      "expo-sharing",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#243b35"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
