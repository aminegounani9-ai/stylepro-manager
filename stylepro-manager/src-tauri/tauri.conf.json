{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StylePro Manager",
  "version": "1.1.1",
  "identifier": "com.stylepro.manager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build -- --mode desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StylePro Manager",
        "width": 1360,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Business",
    "shortDescription": "Gestion professionnelle de boutique, stock, ventes et atelier",
    "longDescription": "StylePro Manager pour la gestion de boutique, catalogue, stock, atelier et utilisateurs.",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
