
import { useCallback, useEffect, useState } from 'react'
import type { FormEvent, CSSProperties } from 'react'
import type { User } from '@supabase/supabase-js'
import {
  Shirt, Store, Package, LogOut, Plus, Sun, Moon,
  RefreshCw, ShieldCheck, AlertCircle, Eye, EyeOff,
  LayoutDashboard, ShoppingBag, Settings, Users,
  TrendingUp, Search, ChevronRight, LockKeyhole
} from 'lucide-react'
import { supabase } from './lib/supabase'
import './stylepro.css'

type StoreRow = {
  id: string
  name: string
  currency: string
}

type ProductRow = {
  id: string
  name: string
  target_audience: string
  active: boolean
}


type CategoryRow = {
  id: string
  name: string
}

type BrandRow = {
  id: string
  name: string
}


type VariantDraft = {
  sku: string
  barcode: string
  size: string
  color: string
  purchase_cost: string
  sale_price: string
  min_stock: string
}

const ADMIN_EMAIL = import.meta.env.VITE_ADMIN_EMAIL as string | undefined

export default function App() {
  const [user, setUser] = useState<User | null>(null)
  const [ready, setReady] = useState(false)
  const [login, setLogin] = useState('')
  const [password, setPassword] = useState('')
  const [showPassword, setShowPassword] = useState(false)
  const [authMode, setAuthMode] = useState<'login' | 'signup'>('login')
  const [storeName, setStoreName] = useState('')
  const [stores, setStores] = useState<StoreRow[]>([])
  const [storeId, setStoreId] = useState('')
  const [products, setProducts] = useState<ProductRow[]>([])
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState('')
  const [message, setMessage] = useState('')
  type ThemeMode = 'light' | 'dark' | 'system'
type AccentName = 'beige' | 'green' | 'blue' | 'burgundy' | 'slate'

const [themeMode, setThemeMode] = useState<ThemeMode>(
  () => (localStorage.getItem('stylepro-theme') as ThemeMode) || 'light'
)
const [accent, setAccent] = useState<AccentName>(
  () => (localStorage.getItem('stylepro-accent') as AccentName) || 'beige'
)
const [settingsOpen, setSettingsOpen] = useState(false)

const dark =
  themeMode === 'dark' ||
  (themeMode === 'system' &&
    window.matchMedia('(prefers-color-scheme: dark)').matches)

const accentColors: Record<AccentName, { primary: string; hover: string }> = {
  beige: { primary: '#a9875b', hover: '#896a43' },
  green: { primary: '#397568', hover: '#285c51' },
  blue: { primary: '#466b9d', hover: '#34547f' },
  burgundy: { primary: '#914c60', hover: '#75394b' },
  slate: { primary: '#626b78', hover: '#48515e' },
}

useEffect(() => {
  localStorage.setItem('stylepro-theme', themeMode)
}, [themeMode])

useEffect(() => {
  localStorage.setItem('stylepro-accent', accent)
}, [accent])
  const [search, setSearch] = useState('')


  
const [categories, setCategories] = useState<CategoryRow[]>([])
const [brands, setBrands] = useState<BrandRow[]>([])


const [showProductForm, setShowProductForm] = useState(false)
const [savingProduct, setSavingProduct] = useState(false)

const [productName, setProductName] = useState('')
const [productDescription, setProductDescription] = useState('')
const [targetAudience, setTargetAudience] = useState('women')
const [categoryId, setCategoryId] = useState('')
const [brandId, setBrandId] = useState('')

const [variantDrafts, setVariantDrafts] = useState<VariantDraft[]>([
  {
    sku: '',
    barcode: '',
    size: '',
    color: '',
    purchase_cost: '0',
    sale_price: '',
    min_stock: '0',
  },
])

  useEffect(() => {
    let alive = true

    supabase.auth.getSession().then(({ data, error }) => {
      if (!alive) return
      if (error) setError(error.message)
      setUser(data.session?.user ?? null)
      setReady(true)
    })

    const { data: listener } = supabase.auth.onAuthStateChange(
      (_event, session) => {
        setUser(session?.user ?? null)
        setError('')
        setMessage('')
      }
    )

    return () => {
      alive = false
      listener.subscription.unsubscribe()
    }
  }, [])

  const loadStores = useCallback(async () => {
    if (!user) return

    setLoading(true)
    setError('')

    const { data, error } = await supabase
      .from('stores')
      .select('id,name,currency')
      .order('created_at', { ascending: true })

    if (error) {
      setError(`Chargement des boutiques : ${error.message}`)
      setLoading(false)
      return
    }

    const rows = (data ?? []) as StoreRow[]
    setStores(rows)
    setStoreId(previous =>
      rows.some(row => row.id === previous) ? previous : rows[0]?.id ?? ''
    )
    setLoading(false)
  }, [user])

  const loadProducts = useCallback(async () => {
    if (!storeId) {
      setProducts([])
      return
    }

    setLoading(true)
    setError('')

    const { data, error } = await supabase
      .from('products')
      .select('id,name,target_audience,active')
      .eq('store_id', storeId)
      .order('name')

    if (error) {
      setError(`Chargement des articles : ${error.message}`)
    } else {
      setProducts((data ?? []) as ProductRow[])
    }

    setLoading(false)
  }, [storeId])

  useEffect(() => {
    if (user) void loadStores()
    else {
      setStores([])
      setStoreId('')
      setProducts([])
    }
  }, [user, loadStores])

  useEffect(() => {
    if (user && storeId) void loadProducts()
    else setProducts([])
  }, [user, storeId, loadProducts])

  
const loadProductOptions = useCallback(async () => {
  if (!storeId) {
    setCategories([])
    setBrands([])
    return
  }

  const [categoryResult, brandResult] = await Promise.all([
    supabase
      .from('categories')
      .select('id,name')
      .eq('store_id', storeId)
      .order('name'),
    supabase
      .from('brands')
      .select('id,name')
      .eq('store_id', storeId)
      .order('name'),
  ])

  if (categoryResult.error) {
    setError(`Chargement des catégories : ${categoryResult.error.message}`)
    return
  }

  if (brandResult.error) {
    setError(`Chargement des marques : ${brandResult.error.message}`)
    return
  }

  setCategories(categoryResult.data ?? [])
  setBrands(brandResult.data ?? [])
}, [storeId])

  useEffect(() => {
    if (user && storeId) {
      void loadProductOptions()
    } else {
      setCategories([])
      setBrands([])
    }
  }, [user, storeId, loadProductOptions])

  async function submitAuth(event: FormEvent<HTMLFormElement>) {
    event.preventDefault()
    setError('')
    setMessage('')
    setLoading(true)

    try {
      if (authMode === 'signup') {
        const { data, error } = await supabase.auth.signUp({
          email: login.trim(),
          password,
        })

        if (error) throw error

        setMessage(
          data.session
            ? 'Compte créé et connecté.'
            : 'Compte créé. Vérifie ton e-mail pour confirmer ton inscription.'
        )
      } else {
        const identifier = login.trim()
        const email = identifier.toLowerCase() === 'admin'
          ? ADMIN_EMAIL?.trim()
          : identifier

        if (!email) {
          throw new Error(
            'Configure VITE_ADMIN_EMAIL dans .env.local pour utiliser le nom admin.'
          )
        }

        const { error } = await supabase.auth.signInWithPassword({
          email,
          password,
        })

        if (error) throw error
        setMessage('Connexion réussie.')
        setPassword('')
      }
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Erreur de connexion.')
    } finally {
      setLoading(false)
    }
  }

  async function createStore(event: FormEvent<HTMLFormElement>) {
    event.preventDefault()
    if (!storeName.trim()) return

    setLoading(true)
    setError('')
    setMessage('')

    try {
      const { data, error } = await supabase.rpc('create_store', {
        p_name: storeName.trim(),
        p_currency: 'DZD',
      })

      if (error) throw error

      const createdId = data as string
      setStoreName('')
      await loadStores()
      setStoreId(createdId)
      setMessage('Boutique créée avec succès.')
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Création impossible.')
    } finally {
      setLoading(false)
    }
  }

  
function addVariantDraft() {
  setVariantDrafts(current => [
    ...current,
    {
      sku: '',
      barcode: '',
      size: '',
      color: '',
      purchase_cost: '0',
      sale_price: '',
      min_stock: '0',
    },
  ])
}

function updateVariantDraft(
  index: number,
  field: keyof VariantDraft,
  value: string
) {
  setVariantDrafts(current =>
    current.map((variant, i) =>
      i === index ? { ...variant, [field]: value } : variant
    )
  )
}

function resetProductForm() {
  setProductName('')
  setProductDescription('')
  setTargetAudience('women')
  setCategoryId('')
  setBrandId('')
  setVariantDrafts([{
    sku: '',
    barcode: '',
    size: '',
    color: '',
    purchase_cost: '0',
    sale_price: '',
    min_stock: '0',
  }])
  setShowProductForm(false)
}

async function saveProduct(event: FormEvent<HTMLFormElement>) {
  event.preventDefault()

  if (!user || !storeId) {
    setError('Connectez-vous et sélectionnez une boutique.')
    return
  }

  if (!productName.trim() || variantDrafts.length === 0) {
    setError('Le nom du produit et au moins une variante sont obligatoires.')
    return
  }

  const seenSkus = new Set<string>()
  const seenBarcodes = new Set<string>()

  for (const variant of variantDrafts) {
    const sku = variant.sku.trim()
    const barcode = variant.barcode.trim()
    const cost = Number(variant.purchase_cost)
    const price = Number(variant.sale_price)
    const minStock = Number(variant.min_stock)

    if (!sku || !variant.sale_price.trim()) {
      setError('Chaque variante doit avoir un SKU et un prix de vente.')
      return
    }

    if (
      !Number.isFinite(cost) || cost < 0 ||
      !Number.isFinite(price) || price < 0 ||
      !Number.isInteger(minStock) || minStock < 0
    ) {
      setError('Vérifiez les prix et le seuil de stock de chaque variante.')
      return
    }

    if (seenSkus.has(sku)) {
      setError(`Le SKU ${sku} est répété dans le formulaire.`)
      return
    }
    seenSkus.add(sku)

    if (barcode && seenBarcodes.has(barcode)) {
      setError(`Le code-barres ${barcode} est répété dans le formulaire.`)
      return
    }
    if (barcode) seenBarcodes.add(barcode)
  }

  setSavingProduct(true)
  setError('')
  setMessage('')


  try {
    const { data: product, error: productError } = await supabase
      .from('products')
      .insert({
        store_id: storeId,
        name: productName.trim(),
        description: productDescription.trim() || null,
        target_audience: targetAudience,
        category_id: categoryId || null,
        brand_id: brandId || null,
        active: true,
      })
      .select('id')
      .single()

    if (productError) throw productError


    const rows = variantDrafts.map(variant => ({
      store_id: storeId,
      product_id: product.id,
      sku: variant.sku.trim(),
      barcode: variant.barcode.trim() || null,
      size: variant.size.trim() || null,
      color: variant.color.trim() || null,
      purchase_cost: Number(variant.purchase_cost),
      sale_price: Number(variant.sale_price),
      min_stock: Number(variant.min_stock),
      active: true,
    }))

    const { error: variantError } = await supabase
      .from('product_variants')
      .insert(rows)

    if (variantError) {
      // Tentative de nettoyage si la création des variantes échoue.
      const { error: cleanupError } = await supabase
        .from('products')
        .delete()
        .eq('id', product.id)
        .eq('store_id', storeId)

      if (cleanupError) {
        throw new Error(
          `Variantes non enregistrées : ${variantError.message}. ` +
          `Le nettoyage a échoué : ${cleanupError.message}. ` +
          `Vérifiez le produit ${product.id}.`
        )
      }

      throw variantError
    }

    resetProductForm()
    setMessage('Produit et variantes enregistrés avec succès.')

    await Promise.all([
      loadProducts(),
      loadProductOptions(),
    ])
  } catch (err) {
    setError(
      err instanceof Error
        ? err.message
        : 'Impossible d’enregistrer le produit.'
    )
  } finally {
    setSavingProduct(false)
  }
}

  async function signOut() {
