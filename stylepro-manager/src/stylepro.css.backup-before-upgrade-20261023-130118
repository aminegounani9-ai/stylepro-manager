
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  font-family: Inter, system-ui, -apple-system, sans-serif;
  color: #30291f;
  background: #f5f1e9;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-optical-sizing: auto;
  font-weight: 400;
  color-scheme: light;
  --bg: #f5f1e9;
  --surface: #fffdf9;
  --text: #30291f;
  --muted: #786f61;
  --border: #e6ddd0;
  --primary: #98764b;
  --primary-hover: #785b38;
  --input-bg: #fffdf9;
  --soft: #eee6da;
  --shadow: 0 12px 32px rgba(74, 55, 30, .08);
  --surface: #fff;
  --text: #30291f;
  --muted: #786f61;
  --border: #e6ddd0;
  --primary: #98764b;
  --primary-hover: #785b38;
  --input-bg: #fff;
  --soft: #eee6da;
  --shadow: 0 10px 35px rgba(20, 35, 65, .055);
}

* { box-sizing: border-box; }

html, body, #root { min-height: 100%; margin: 0; }
body { min-width: 320px; background: var(--bg); }
button, input, select { font: inherit; }
button { cursor: pointer; }
button:disabled { opacity: .65; cursor: wait; }
button:focus-visible, input:focus-visible, select:focus-visible {
  outline: 3px solid rgba(49, 94, 234, .25);
  outline-offset: 2px;
}
a { color: inherit; text-decoration: none; }

.app {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  display: flex;
  flex-direction: column;
  transition: background .2s, color .2s;
}
.app.dark {
  color-scheme: dark;
  --bg: #0c1321;
  --surface: #141f31;
  --text: #f1f5fb;
  --muted: #b0bdd0;
  --border: #2b3950;
  --primary: #d0b58c;
  --primary-hover: #e0cba8;
  --input-bg: #101a2b;
  --soft: #202d42;
  --shadow: 0 10px 35px rgba(0, 0, 0, .16);
  background: var(--bg);
}

.topbar {
  min-height: 78px;
  padding: 13px clamp(16px, 4vw, 52px);
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  position: relative;
  z-index: 2;
}
.brand, .header-actions { display: flex; align-items: center; gap: 14px; }
.brand-icon {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  color: #fff;
  background: linear-gradient(145deg, #b89a70, #785b38);
  border-radius: 14px;
  box-shadow: 0 5px 15px #98764b32;
  flex-shrink: 0;
}
.brand-copy strong { display: block; font-size: 17px; letter-spacing: -.45px; }
.brand-copy strong span { color: var(--primary); }
.brand-copy small {
  display: block;
  color: var(--muted);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.25px;
  margin-top: 5px;
}
.system-status {
  color: var(--muted);
  font-size: 11px;
  display: flex;
  align-items: center;
  gap: 7px;
}
.status-dot { width: 7px; height: 7px; border-radius: 50%; background: #16a36a; }
.icon-button, .secondary-button, .primary-button, .text-button {
  min-height: 42px;
  padding: 10px 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  border: 1px solid transparent;
  border-radius: 10px;
  font-size: 12px;
  font-weight: 700;
  transition: background .18s, border-color .18s, transform .18s;
}
.icon-button, .secondary-button {
  background: var(--soft);
  color: var(--text);
  border-color: var(--border);
}
.icon-button { width: 42px; padding: 0; }
.icon-button:hover, .secondary-button:hover { border-color: #aebdd2; }
.primary-button {
  color: #fff;
  background: #98764b;
  border-color: #98764b;
}
.primary-button:hover { background: #785b38; }
.app.dark .primary-button { color: #30291f; background: #d7bd95; border-color: #d7bd95; }
.text-button { color: var(--primary); background: transparent; }
.primary-button:active, .secondary-button:active { transform: translateY(1px); }

.login-layout {
  flex: 1;
  width: 100%;
  max-width: 1500px;
  margin: 0 auto;
  padding: 34px clamp(18px, 5vw, 72px);
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(360px, .8fr);
  gap: clamp(28px, 7vw, 100px);
  align-items: center;
}
.login-presentation { padding: 30px 0; max-width: 590px; }
.presentation-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 12px;
  border: 1px solid #dfceb3;
  border-radius: 999px;
  color: #244ac7;
  background: #f2e8d8;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
}
.app.dark .presentation-badge { background: #1b2c50; border-color: #354c80; color: #b8c8ff; }
.login-presentation h1 {
  margin: 26px 0 20px;
  font-size: clamp(40px, 5.2vw, 68px);
  line-height: 1.08;
  letter-spacing: -3px;
  font-weight: 800;
}
.login-presentation h1 span {
  background: linear-gradient(100deg, #98764b, #d0b58c);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.login-presentation > p {
  max-width: 500px;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.9;
}
.feature-list { display: grid; gap: 21px; margin-top: 35px; }
.feature-list > div { display: flex; align-items: center; gap: 14px; }
.feature-list > div > svg {
  width: 42px;
  height: 42px;
  padding: 11px;
  border-radius: 12px;
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--primary);
}
.feature-list strong, .feature-list small { display: block; }
.feature-list strong { font-size: 13px; margin-bottom: 5px; }
.feature-list small { color: var(--muted); font-size: 12px; }
.presentation-footer {
  margin-top: 54px;
  color: var(--muted);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
}
.presentation-footer span { padding: 0 8px; color: var(--primary); }

.login-side { width: 100%; display: flex; justify-content: center; }
.auth-card {
  width: 100%;
  max-width: 470px;
  padding: clamp(24px, 3vw, 38px);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 22px;
  box-shadow: var(--shadow);
}
.mobile-brand { display: none; }
.auth-heading-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  color: var(--primary);
  background: var(--soft);
  border: 1px solid var(--border);
  border-radius: 14px;
  margin-bottom: 23px;
}
.eyebrow {
  color: var(--primary);
  font-size: 10px;
  letter-spacing: 1.7px;
  font-weight: 800;
  margin: 0 0 10px;
}
.auth-card h2 { font-size: clamp(22px, 2.5vw, 28px); letter-spacing: -.8px; margin: 0; }
.auth-description { color: var(--muted); font-size: 12px; line-height: 1.7; margin: 11px 0 24px; }
.form { display: grid; gap: 19px; }
.form label, .field {
  display: grid;
  gap: 9px;
  color: var(--text);
  font-size: 12px;
  font-weight: 700;
}
.input-wrap { position: relative; display: flex; align-items: center; }
.input-icon {
  position: absolute;
  left: 14px;
  color: var(--muted);
  pointer-events: none;
}
input, select {
  width: 100%;
  min-width: 0;
  min-height: 47px;
  padding: 12px 13px;
  border: 1px solid #cbd4e1;
  border-radius: 10px;
  background: var(--input-bg);
  color: var(--text);
  outline: none;
  font-size: 12px;
  transition: border-color .18s, box-shadow .18s;
}
.input-wrap input { padding-left: 43px; padding-right: 44px; }
input::placeholder { color: #68778d; opacity: 1; }
.app.dark input::placeholder { color: #aab8cd; }
input:focus, select:focus {
  border-color: #98764b;
  box-shadow: 0 0 0 3px rgba(49, 94, 234, .14);
}
.password-toggle {
  position: absolute;
  right: 8px;
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 7px;
  color: var(--muted);
  background: transparent;
}
.password-toggle:hover { background: var(--soft); color: var(--text); }
.login-submit { min-height: 48px; margin-top: 3px; justify-content: space-between; padding: 12px 16px; }
.auth-switch {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 22px;
  color: var(--muted);
  font-size: 11px;
  text-align: center;
}
.auth-switch button {
  padding: 2px;
  border: 0;
  background: transparent;
  color: var(--primary);
  font-size: 11px;
  font-weight: 800;
}
.auth-security {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding-top: 18px;
  margin-top: 21px;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 10px;
}

.workspace {
  width: 100%;
  max-width: 1600px;
  margin: 0 auto;
  flex: 1;
  display: grid;
  grid-template-columns: 238px minmax(0, 1fr);
  align-items: start;
}
.sidebar {
  position: sticky;
  top: 0;
  min-height: calc(100vh - 78px);
  padding: 27px 16px 18px;
  background: var(--surface);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
}
.sidebar-caption {
  margin: 0 12px 17px;
  color: var(--muted);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.4px;
}
.nav-item {
  min-height: 44px;
  margin: 3px 0;
  padding: 0 12px;
  display: flex;
  align-items: center;
  gap: 11px;
  border-radius: 9px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
}
.nav-item.active { background: #f2e8d8; color: #244ac7; }
.app.dark .nav-item.active { background: #1d2e51; color: #b8c8ff; }
.nav-soon { margin-left: auto; color: var(--muted); font-size: 9px; }
.nav-bottom {
  margin-top: auto;
  padding: 17px 10px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--muted);
  font-size: 11px;
}
.sidebar-user {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 15px 7px 0;
  border-top: 1px solid var(--border);
}
.avatar {
  width: 35px;
  height: 35px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  background: #98764b;
  color: white;
  font-weight: 800;
}
.sidebar-user-info { min-width: 0; }
.sidebar-user-info strong, .sidebar-user-info small { display: block; overflow-wrap: anywhere; }
.sidebar-user-info strong { font-size: 10px; margin-bottom: 4px; }
.sidebar-user-info small { font-size: 9px; color: var(--muted); }
.dashboard-content { min-width: 0; padding: 34px clamp(16px, 3vw, 42px); }
.welcome, .section-heading, .catalogue-header, .panel-title {
  display: flex;
  align-items: center;
  gap: 13px;
}
.welcome { justify-content: space-between; gap: 20px; margin-bottom: 25px; }
.welcome h1 { font-size: clamp(25px, 3vw, 32px); letter-spacing: -1px; margin: 0 0 8px; }
.muted { color: var(--muted); font-size: 12px; line-height: 1.6; margin: 0; }
.secure-label { display: flex; align-items: center; gap: 7px; color: #14865a; font-size: 11px; white-space: nowrap; }
.app.dark .secure-label { color: #6fe0af; }
.stats-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15px; margin-bottom: 23px; }
.stat-card {
  min-width: 0;
  padding: 20px;
  border: 1px solid var(--border);
  border-radius: 15px;
  background: var(--surface);
  box-shadow: var(--shadow);
}
.stat-icon { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 11px; margin-bottom: 16px; }
.stat-icon svg { width: 19px; }
.stat-icon.blue { color: #98764b; background: #f2e8d8; }
.stat-icon.violet { color: #7851d6; background: #f1ebff; }
.stat-icon.green { color: #14865a; background: #e6f8ef; }
.stat-card > span { display: block; color: var(--muted); font-size: 11px; }
.stat-card > strong { display: block; font-size: 27px; margin: 7px 0; letter-spacing: -.8px; }
.stat-card > small { display: block; color: var(--muted); font-size: 10px; line-height: 1.5; }

.panel {
  min-width: 0;
  padding: 22px;
  margin-bottom: 22px;
  border: 1px solid var(--border);
  border-radius: 15px;
  background: var(--surface);
  box-shadow: var(--shadow);
}
.panel-heading { margin-bottom: 21px; }
.panel-title { align-items: flex-start; color: var(--primary); }
.panel-title > svg { flex-shrink: 0; margin-top: 2px; }
.panel-title h2 { color: var(--text); font-size: 15px; margin: 0 0 6px; }
.panel-title p { color: var(--muted); font-size: 11px; margin: 0; line-height: 1.6; }
.field { max-width: 520px; margin-bottom: 16px; }
.inline-form { display: flex; gap: 10px; }
.inline-form input { flex: 1; }
.catalogue-header { justify-content: space-between; flex-wrap: wrap; }
.catalogue-tools { display: flex; justify-content: flex-end; margin: 18px 0; }
.search-box { position: relative; width: min(100%, 320px); }
.search-box > svg { position: absolute; left: 12px; top: 14px; color: var(--muted); }
.search-box input { padding-left: 38px; min-height: 43px; }
.table-wrap { overflow-x: auto; width: 100%; }
table { width: 100%; border-collapse: collapse; font-size: 12px; }
th, td { padding: 14px 12px; border-bottom: 1px solid var(--border); text-align: left; white-space: nowrap; }
th { color: var(--muted); background: var(--soft); font-size: 10px; font-weight: 800; }
td { color: var(--text); }
tbody tr:hover { background: var(--soft); }
.product-name { display: flex; align-items: center; gap: 10px; }
.product-mini-icon { width: 32px; height: 32px; display: grid; place-items: center; border: 1px solid var(--border); border-radius: 9px; color: var(--primary); background: var(--soft); }
.status-pill { display: inline-flex; padding: 5px 9px; border-radius: 999px; font-size: 10px; font-weight: 800; }
.active-pill { color: #11754d; background: #e2f7ec; }
.inactive-pill { color: #6b7280; background: #edf0f5; }
.app.dark .active-pill { color: #a0f0c7; background: #173d33; }
.app.dark .inactive-pill { color: #c1cada; background: #2b3749; }
.empty-state { padding: 35px 12px; text-align: center; color: var(--muted); }
.empty-state > svg { margin-bottom: 12px; color: var(--primary); }
.empty-state strong { display: block; color: var(--text); font-size: 13px; }
.empty-state p { font-size: 11px; line-height: 1.7; }

.alert {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 13px 14px;
  margin-bottom: 16px;
  border-radius: 10px;
  font-size: 12px;
  line-height: 1.65;
  overflow-wrap: anywhere;
}
.alert svg { flex-shrink: 0; margin-top: 1px; }
.error { background: #fff0f0; border: 1px solid #ffd2d2; color: #9d1c1c; }
.success { background: #e7f8ef; border: 1px solid #c3edd5; color: #11643e; }
.app.dark .error { background: #421f2a; border-color: #773646; color: #ffc3c8; }
.app.dark .success { background: #153a2c; border-color: #25634b; color: #b0f2cc; }

.center { min-height: 100vh; display: flex; align-items: center; justify-content: center; gap: 12px; color: var(--text); }
.spin { animation: spin 1.2s linear infinite; }
.footer {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 17px clamp(16px, 4vw, 52px);
  border-top: 1px solid var(--border);
  background: var(--surface);
  color: var(--muted);
  font-size: 10px;
}
.footer i { color: var(--primary); font-style: normal; padding: 0 4px; }

@keyframes spin { to { transform: rotate(360deg); } }

@media (max-width: 1050px) {
  .login-layout { gap: 30px; padding-inline: 28px; }
  .login-presentation h1 { font-size: 48px; }
  .workspace { grid-template-columns: 205px minmax(0, 1fr); }
  .dashboard-content { padding: 27px 20px; }
  .stats-grid { gap: 10px; }
  .stat-card { padding: 15px; }
}

@media (max-width: 760px) {
  .topbar { min-height: 68px; padding: 11px 15px; }
  .brand-icon { width: 40px; height: 40px; border-radius: 12px; }
  .brand-copy strong { font-size: 15px; }
  .brand-copy small, .system-status { display: none; }
  .header-actions { gap: 8px; }
  .secondary-button { padding: 9px 10px; }
  .login-layout { display: block; padding: 18px 15px 30px; }
  .login-presentation { display: none; }
  .login-side { padding: 10px 0; }
  .auth-card { max-width: 480px; padding: 24px 20px; border-radius: 17px; }
  .mobile-brand { display: flex; align-items: center; gap: 10px; margin-bottom: 27px; font-size: 14px; }
  .mobile-brand .brand-icon { width: 36px; height: 36px; }
  .auth-heading-icon { margin-bottom: 18px; }
  .workspace { display: block; }
  .sidebar { position: static; min-height: auto; padding: 12px 14px; border-right: 0; border-bottom: 1px solid var(--border); display: block; }
  .sidebar-caption, .nav-bottom, .sidebar-user, .nav-item:nth-of-type(n+4) { display: none; }
  .nav-item { display: inline-flex; margin: 2px; padding: 0 10px; min-height: 38px; font-size: 10px; }
  .nav-soon { display: none; }
  .dashboard-content { padding: 23px 14px; }
  .welcome { align-items: flex-start; flex-direction: column; gap: 12px; }
  .stats-grid { grid-template-columns: 1fr; }
  .stat-card { display: grid; grid-template-columns: 40px 1fr; align-items: center; column-gap: 12px; padding: 13px 15px; }
  .stat-icon { grid-row: span 3; margin: 0; }
  .stat-card > span, .stat-card > strong, .stat-card > small { margin: 0; }
  .stat-card > strong { font-size: 22px; }
  .panel { padding: 17px 14px; }
  .inline-form { flex-direction: column; }
  .inline-form .primary-button { width: 100%; }
  .catalogue-header { align-items: flex-start; }
  .catalogue-tools { justify-content: stretch; }
  .search-box { width: 100%; }
  .footer { flex-direction: column; align-items: center; text-align: center; }
}

/* ==========================================
   STYLEPRO MANAGER — BEIGE PREMIUM EDITION
   ========================================== */

:root {
  font-family: Inter, system-ui, -apple-system, sans-serif;
  color-scheme: light;
  --bg: #e9e0d4;
  --surface: #f5efe6;
  --text: #292722;
  --muted: #71695f;
  --border: #d5c9b9;
  --primary: #a9875b;
  --primary-hover: #896a43;
  --input-bg: #eee5d9;
  --soft: #e8ddcf;
  --shadow: 0 8px 24px rgba(65, 49, 31, .07);
}

body {
  background: #e9e0d4;
}

.app {
  background: var(--bg);
  color: var(--text);
}

.app.dark {
  color-scheme: dark;
  --bg: #201e1b;
  --surface: #2a2723;
  --text: #f3ede4;
  --muted: #c1b5a6;
  --border: #484137;
  --input-bg: #332f29;
  --soft: #383229;
  --shadow: 0 8px 24px rgba(0, 0, 0, .18);
  background: var(--bg);
}

.topbar,
.sidebar,
.footer {
  background: var(--surface);
  border-color: var(--border);
}

.brand-icon {
  color: #fff8ee;
  background: linear-gradient(145deg, #c6a77e, #886842);
  box-shadow: 0 5px 15px rgba(137, 106, 67, .22);
}

.brand-copy strong span {
  color: var(--primary);
}

.icon-button,
.secondary-button {
  background: var(--soft);
  color: var(--text);
  border-color: var(--border);
}

.primary-button {
  color: #fffaf3;
  background: var(--primary);
  border-color: var(--primary);
}

.primary-button:hover {
  background: var(--primary-hover);
  border-color: var(--primary-hover);
}

.app.dark .primary-button {
  color: #fffaf3;
  background: var(--primary);
  border-color: var(--primary);
}

.presentation-badge {
  color: #705432;
  background: #e9ddcb;
  border-color: #cbb393;
}

.app.dark .presentation-badge {
  color: #e8cfaa;
  background: #393126;
  border-color: #6c5840;
}

.login-presentation h1 span {
  background: linear-gradient(100deg, #a9875b, #d1b48b);
  -webkit-background-clip: text;
  background-clip: text;
}

input,
select {
  background: var(--input-bg);
  color: var(--text);
  border-color: var(--border);
}

input::placeholder {
  color: var(--muted);
}

input:focus,
select:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 18%, transparent);
}

.nav-item {
  color: var(--muted);
}

.nav-item.active {
  background: #e4d5c0;
  color: #5f4529;
}

.app.dark .nav-item.active {
  background: #44392b;
  color: #e8cba0;
}

.avatar {
  background: var(--primary);
}

.stat-icon.blue,
.stat-icon.violet,
.stat-icon.green {
  color: var(--primary);
  background: var(--soft);
}

.panel,
.stat-card,
.auth-card {
  background: var(--surface);
  border-color: var(--border);
  box-shadow: var(--shadow);
}

.panel-title {
  color: var(--primary);
}

th {
  background: var(--soft);
  color: var(--muted);
}

tbody tr:hover {
  background: var(--soft);
}

.product-mini-icon {
  color: var(--primary);
  background: var(--soft);
}

.footer i {
  color: var(--primary);
}

/* Navigation Paramètres */

.settings-nav {
  width: 100%;
  border: 0;
  border-radius: 9px;
  background: transparent;
  text-align: left;
  cursor: pointer;
}

.settings-nav:hover,
.settings-nav.selected {
  color: var(--primary);
  background: var(--soft);
}

.settings-nav > svg:last-child {
  margin-left: auto;
  transition: transform .2s ease;
}

.settings-nav .rotate-chevron {
  transform: rotate(90deg);
}

/* Thème & Apparence */

.appearance-panel {
  margin-top: -5px;
  animation: appearance-in .2s ease-out;
}

.appearance-field {
  margin-top: 24px;
}

.palette-label {
  margin: 20px 0 12px;
  color: var(--text);
  font-size: 12px;
  font-weight: 700;
}

.palette-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.palette-choice {
  position: relative;
  min-width: 82px;
  padding: 12px 9px 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  color: var(--text);
  background: var(--input-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  transition: border-color .2s, transform .2s, background .2s;
}

.palette-choice:hover {
  transform: translateY(-2px);
  border-color: var(--primary);
}

.palette-choice.chosen {
  border: 2px solid var(--primary);
  padding: 11px 8px 9px;
  background: var(--soft);
}

.palette-choice > span:first-child {
  width: 29px;
  height: 29px;
  border-radius: 50%;
  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .08);
}

.palette-choice small {
  font-size: 10px;
  font-weight: 600;
}

.palette-check {
  position: absolute;
  top: 16px;
  color: white;
  font-size: 14px;
  font-weight: 800;
  text-shadow: 0 1px 3px #333;
}

.appearance-note {
  margin: 20px 0 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.7;
}

@keyframes appearance-in {
  from { opacity: 0; transform: translateY(-5px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 600px) {
  .palette-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .palette-choice {
    min-width: 0;
  }
}

