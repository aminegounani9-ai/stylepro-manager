/* StylePro Manager — fixed app frame and independent content scrolling */
html,
body,
#root {
  width: 100%;
  height: 100%;
  min-height: 0;
}

body {
  overflow: hidden;
}

#root {
  overflow: hidden;
}

.app {
  width: 100%;
  height: 100vh;
  height: 100dvh;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* Keep the app header visible */
.topbar {
  flex: 0 0 auto;
  z-index: 20;
}

/* Main content can scroll without moving the outer frame */
main,
.main-content,
.page-content,
.content-area,
.dashboard-content,
.catalogue-content,
.module-content {
  min-height: 0;
  overscroll-behavior: contain;
}

/* Scroll only the actual page/content region */
main,
.main-content,
.page-content,
.content-area,
.dashboard-content,
.catalogue-content,
.module-content {
  overflow-y: auto;
  overflow-x: auto;
  scrollbar-gutter: stable;
  -webkit-overflow-scrolling: touch;
}

/* Tables remain usable on narrow screens */
table {
  max-width: 100%;
}

@media (max-width: 768px) {
  .app {
    height: 100dvh;
  }

  main,
  .main-content,
  .page-content,
  .content-area,
  .dashboard-content,
  .catalogue-content,
  .module-content {
    overscroll-behavior-y: contain;
  }
}

/* StylePro Manager — fixed application frame */
html,
body,
#root {
  width: 100%;
  height: 100%;
  min-height: 0;
}

body {
  overflow: hidden;
}

#root {
  overflow: hidden;
}

.app {
  width: 100%;
  height: 100vh;
  height: 100dvh;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.topbar {
  flex: 0 0 auto;
  position: relative;
  z-index: 20;
}

/* The authenticated workspace fills the space below the header */
.workspace {
  display: flex;
  flex: 1 1 auto;
  min-height: 0;
  min-width: 0;
  overflow: hidden;
}

/* Sidebar scrolls independently */
.workspace > .sidebar {
  flex: 0 0 250px;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior-y: contain;
  scrollbar-gutter: stable;
  -webkit-overflow-scrolling: touch;
}

/* Main module area scrolls independently */
.workspace > .dashboard-content {
  flex: 1 1 auto;
  min-width: 0;
  min-height: 0;
  height: 100%;
  overflow-x: auto;
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-gutter: stable;
  -webkit-overflow-scrolling: touch;
}

/* Keep wide tables inside the module's own scroll area */
.dashboard-content table {
  max-width: 100%;
}

/* Login screen remains usable on smaller screens */
.login-layout {
  min-height: 0;
  flex: 1 1 auto;
  overflow-y: auto;
  overscroll-behavior-y: contain;
}

@media (max-width: 1050px) {
  .workspace > .sidebar {
    flex-basis: 220px;
  }
}

@media (max-width: 760px) {
  .workspace {
    min-height: 0;
  }

  .workspace > .sidebar {
    flex-basis: 190px;
  }

  .workspace > .dashboard-content {
    padding: 20px 14px;
  }
}

/* Sidebar sizing correction */
.workspace {
  display: grid;
  grid-template-columns: 250px minmax(0, 1fr);
  flex: 1 1 auto;
  min-height: 0;
  min-width: 0;
  overflow: hidden;
}

.workspace > .sidebar {
  width: 250px;
  min-width: 250px;
  max-width: 250px;
  flex: none;
  height: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
  overflow-y: auto;
}

.workspace > .dashboard-content {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 100%;
  box-sizing: border-box;
  overflow: auto;
}

@media (max-width: 760px) {
  .workspace {
    grid-template-columns: 175px minmax(0, 1fr);
  }

  .workspace > .sidebar {
    width: 175px;
    min-width: 175px;
    max-width: 175px;
  }

  .workspace > .dashboard-content {
    padding: 16px 12px;
  }
}
