                      </div>

                      <label>
                        Stock minimum
                        <input
                          type="number"
                          min="0"
                          step="1"
                          value={variant.min_stock}
                          onChange={e => updateVariantDraft(index, 'min_stock', e.target.value)}
                          required
                        />
                      </label>
                    </div>
