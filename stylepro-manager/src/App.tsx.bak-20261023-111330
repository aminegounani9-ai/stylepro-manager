                      posCart.map(i => <div className="pos-cart-row" key={i.variant_id}>
                        <div className="pos-cart-info"><strong>{i.name}</strong><small>{i.sku} · {i.unit_price.toLocaleString('fr-DZ')} DZD</small></div>
                        <div className="pos-quantity">
