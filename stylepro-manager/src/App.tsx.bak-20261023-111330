                          {!product.active && (
                            <button
                              type="button"
                              className="secondary-button"
                              onClick={() => void restoreProduct(product)}
                              disabled={loading || savingProduct}
                            >
                              <RotateCcw size={15} /> Restaurer
                            </button>
                          )}
                        </div>
                      </td>
                    </tr>
                  ))}</tbody>
                </table></div>
              )}
            </section>
              </>
            )}
          </section>
        </div>
      )}

      <footer className="footer">
        <span>© {new Date().getFullYear()} StylePro Manager</span>
        <span>Gestion commerciale <i>•</i> Sécurisée par Supabase</span>
      </footer>
    </main>
  )
